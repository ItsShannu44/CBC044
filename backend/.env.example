# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vidyasutra

# Set to true when the database needs SSL (Render external URL, Neon, Supabase)
DATABASE_SSL=false

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Only needed in development, when the React dev server runs on another port
CLIENT_ORIGIN=http://localhost:5173

# Email alerts (optional). Without SMTP the app works normally and notifications
# appear only inside the app. Gmail example: host smtp.gmail.com, port 465, user
# you@gmail.com, pass = an app password from https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VidyaSutra <no-reply@vidyasutra.app>
